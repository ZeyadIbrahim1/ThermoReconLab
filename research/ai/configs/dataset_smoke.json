{
  "schema_version": 2,
  "random_seed": 5102,
  "output_directory": "data_external/phase5_dataset_smoke",
  "grid_shape": [8, 8],
  "num_samples": 18,
  "source_family_probabilities": {
    "one_gaussian": 0.25,
    "multiple_gaussians": 0.2,
    "elliptical_hotspot": 0.15,
    "rectangle": 0.1,
    "circular_compact": 0.1,
    "elongated_source": 0.1,
    "overlapping_hotspots": 0.05,
    "irregular_composite": 0.05,
    "sharp_edged": 0.0
  },
  "source_count_range": [2, 3],
  "allow_signed_sources": false,
  "signed_probability": 0.0,
  "amplitude_range": [0.8, 2.0],
  "width_range": [0.07, 0.15],
  "size_range": [0.1, 0.25],
  "sensor_strategies": ["regular_grid", "random", "center_focused"],
  "sensor_count_range": [6, 10],
  "sensor_seeds": [9200],
  "noise_levels": [0.0, 0.01, 0.08],
  "identity_alpha_choices": [0.001, 0.01],
  "smoothness_alpha_choices": [0.0001, 0.001],
  "split_rules": {
    "method": "explicit_role_counts_before_generation",
    "counts": {
      "train": 3,
      "validation": 3,
      "test_id": 3,
      "test_ood_shape": 3,
      "test_ood_sensor": 3,
      "test_ood_noise": 3
    }
  },
  "ood_source_families": ["sharp_edged"],
  "ood_sensor_strategies": ["center_focused"],
  "ood_noise_levels": [0.08],
  "normalization": {"enabled": true, "method": "global_standard", "fit_split": "train"},
  "storage_compression": "gzip",
  "preview_count": 3
}
